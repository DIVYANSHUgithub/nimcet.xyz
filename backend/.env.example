# Server-only configuration. Keep DATABASE_URL in a secret manager or ignored .env file.
# Use a dedicated least-privilege database role; do not put a service-role key here as a
# substitute for database grants and backend authorization.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWT_MODE=
SUPABASE_JWT_ALGORITHM=
SUPABASE_JWT_SECRET=
# Owner-selected target is the Supabase direct Postgres endpoint. Use the correct
# least-privilege login role and TLS settings; keep the actual URI in backend/.env.
DATABASE_URL=
DATABASE_SSL_ROOT_CERT=certs/supabase-ca.crt
DATABASE_POOL_SIZE=3
TRUSTED_ROLE_LOOKUP_ENABLED=false
TEST_ENGINE_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Enable only after the Phase 2 migration and permissions pass staging checks.
QUESTION_AUTHORING_ENABLED=false
# Server-only Supabase Storage secret/service key. Never use VITE_ for this key.
SUPABASE_STORAGE_KEY=
STORAGE_BUCKET=question-media

# Requires the Phase 5 migration and staging verification.
PHASE5_ENABLED=false

# Admin workflow migration, trusted role lookup and staging verification required.
ADMIN_WORKFLOWS_ENABLED=false
# Server-only Auth Admin key for paginated user lookup. Never use a VITE_ variable.
SUPABASE_ADMIN_KEY=
