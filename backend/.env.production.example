# Supply actual secrets through the hosting provider. Never commit a filled copy.
ENVIRONMENT=production
LOG_LEVEL=INFO
SUPABASE_URL=https://wcxxyyebcgofziylgwdg.supabase.co
SUPABASE_JWT_ISSUER=https://wcxxyyebcgofziylgwdg.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://wcxxyyebcgofziylgwdg.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_ALGORITHM=ES256
# Copy the existing nimcet_backend pooler connection from the ignored backend/.env.
# Keep sslmode=verify-full. DATABASE_SSL_ROOT_CERT overrides its old Windows path.
DATABASE_URL=
DATABASE_SSL_ROOT_CERT=certs/supabase-ca.crt
DATABASE_POOL_SIZE=3
# Replace with the actual frontend origins (no paths or trailing slashes).
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.example.com
TRUSTED_ROLE_LOOKUP_ENABLED=true
TEST_ENGINE_ENABLED=true
QUESTION_AUTHORING_ENABLED=false
PHASE5_ENABLED=false
ADMIN_WORKFLOWS_ENABLED=false
